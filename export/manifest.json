{
  "manifest_version": 3,
  "name": "Gen Console Export",
  "version": "1.1.0",
  "description": "Export Google cookies for Gen Console token pool",
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gen Console Export"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
