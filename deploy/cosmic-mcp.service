[Unit]
Description=Cosmic AI Console MCP Gateway
After=network-online.target gemini-proxy.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/work/gemini-proxy/mcp
EnvironmentFile=/home/ubuntu/work/gemini-proxy/.env.mcp
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
UMask=0077
ReadWritePaths=/home/ubuntu/work/gemini-proxy/mcp-state
MemoryMax=256M
MemoryHigh=224M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
